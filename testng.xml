<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="QA Automation Suite" verbose="1">
    <listeners>
        <!-- Allure listener -->
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <test name="API Tests">
        <classes>
            <class name="com.qa.tests.api.AuthApiTest"></class>
            <class name="com.qa.tests.api.BookingApiWithNegativeTest"/>
            <class name="com.qa.tests.api.BookingAPITest"/>
        </classes>
    </test>
</suite>
